{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "$comment": "separate-pull-requests, so each release PR names its own version. With both packages in one PR release-please cannot fit two versions in one title and falls back to `chore: release main` - the repo went from `chore(main): release 0.2.1` to a title saying nothing. They also release on genuinely independent cadences: the moving v0 tag that every consumer pins, and an npm package. One PR each keeps those decisions separate.",
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "shared-workflows",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "refactor", "section": "Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true }
      ]
    },
    "packages/dev-config": {
      "release-type": "node",
      "package-name": "@blinkbitcoin/dev-config",
      "component": "dev-config",
      "bump-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "refactor", "section": "Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true }
      ]
    }
  }
}
